generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// ======================================================
// USER
// ======================================================

model User {
  id        Int        @id @default(autoincrement())
  nom       String
  prenom    String
  email     String     @unique
  password  String
  role      Role       @default(ACHETEUR)
  statut    UserStatut @default(ACTIF)
  emailVerified Boolean @default(false)
  refreshTokenHash String?
  telephone String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  client    Client?    
  supplier  Supplier?
  @@map("users")
}

enum Role {
  ADMIN
  VENDEUR
  ACHETEUR
}

enum UserStatut {
  ACTIF
  INACTIF
}


// ======================================================
// CLIENT
// ======================================================

model Client {
  id          Int          @id @default(autoincrement())
  displayName String
  entreprise  String?
  telephone2  String?
  statut      ClientStatut @default(ACTIF)
  type        ClientType
  
  addresses   Address[]
  quotes      Quote[]
  commandes   PurchaseOrder[]
  userId      Int?         @unique  // Un client ne peut être lié qu'à un seul user
  user        User?        @relation(fields: [userId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("clients")
}

enum ClientStatut {
  ACTIF
  INACTIF
}

enum ClientType {
  PARTICULIER
  ENTREPRISE
}


// ======================================================
// FOURNISSEUR
// ======================================================

model Supplier {
  id             Int            @id @default(autoincrement())
  displayName    String
  entreprise     String?
  telephone2     String?
  website        String?
  dateCreation   DateTime?
  paymentTerms   Json?
  bankInfo       Json?
  statut         SupplierStatut @default(ACTIF)
  type           SupplierType
  addresses      Address[]
  products       Product[]
  quotes         Quote[]
  commandes      PurchaseOrder[]
  userId         Int?           @unique  // Un fournisseur ne peut être lié qu'à un seul user
  user           User?          @relation(fields: [userId], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("suppliers")
}

enum SupplierStatut {
  ACTIF
  INACTIF
}

enum SupplierType {
  FABRICANT
  GROSSISTE
  DISTRIBUTEUR
  AUTRE
}


// ======================================================
// ADRESSE
// ======================================================

model Address {
  id            Int      @id @default(autoincrement())
  displayName   String?
  attention     String?
  line1         String
  line2         String?
  line3         String?
  city          String
  province      String?
  postalCode    String?
  country       String
  telephone     String?
  contactName   String?
  contactPhone  String?
  contactEmail  String?

  clientId      Int?
  supplierId    Int?

  client        Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  supplier      Supplier? @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("addresses")
}


// ======================================================
// VERTICAL
// ======================================================

model Vertical {
  id          Int            @id @default(autoincrement())
  nom         String
  description String?
  statut      VerticalStatut @default(ACTIF)

  categories  Category[]

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("verticals")
}

enum VerticalStatut {
  ACTIF
  INACTIF
}


// ======================================================
// CATEGORY
// ======================================================

model Category {
  id          Int             @id @default(autoincrement())
  nom         String
  description String?
  statut      CategoryStatut  @default(ACTIF)

  verticalId  Int
  vertical    Vertical        @relation(fields: [verticalId], references: [id])

  products    Product[]

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("categories")
}

enum CategoryStatut {
  ACTIF
  INACTIF
}


// ======================================================
// PRODUCT
// ======================================================

model Product {
  id                Int            @id @default(autoincrement())
  nom               String
  description       String?
  specifications    String?
  statut            ProductStatut  @default(ACTIF)
  supplierId        Int
  categoryId        Int

  uom               UOM
  moq               Int?
  quantityMinimum   Int?
  quantityMultiples Int?
  quantityMasterPack Int?

  dimensionLongueur Decimal?
  dimensionLargeur  Decimal?
  dimensionHauteur  Decimal?
  dimensionPoids    Decimal?

  basePrice         Decimal        @db.Decimal(12, 2)
  cost              Decimal?       @db.Decimal(12, 2)
  msrp              Decimal?       @db.Decimal(12, 2)

  leadTime          Int?

  supplier          Supplier       @relation(fields: [supplierId], references: [id])
  category          Category       @relation(fields: [categoryId], references: [id])
  images            Image[]
  poItems           POItem[]

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@map("products")
}

enum ProductStatut {
  ACTIF
  INACTIF
  RUPTURE
}

enum UOM {
  PIECE
  KILOGRAMME
  GRAMME
  LITRE
  METRE
  BOITE
  CARTON
  AUTRE
}


// ======================================================
// IMAGE
// ======================================================

model Image {
  id         Int      @id @default(autoincrement())
  productId  Int

  url        String
  altText    String?
  isPrimary  Boolean  @default(false)
  position   Int      @default(0)

  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("images")
}


// ======================================================
// QUOTE
// ======================================================

model Quote {
  id          Int          @id @default(autoincrement())
  nom         String
  statut      QuoteStatut  @default(BROUILLON)

  clientId    Int
  supplierId  Int

  items       Json?
  notes       String?
  total       Decimal?     @db.Decimal(12, 2)
  leadTime    Int?

  client      Client       @relation(fields: [clientId], references: [id])
  supplier    Supplier     @relation(fields: [supplierId], references: [id])

  purchaseOrder PurchaseOrder?

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("quotes")
}

enum QuoteStatut {
  BROUILLON
  ENVOYE
  ACCEPTE
  REFUSE
  EXPIRE
}


// ======================================================
// PURCHASE ORDER
// ======================================================

model PurchaseOrder {
  id              Int             @id @default(autoincrement())
  poNumber        String          @unique
  statut          PurchaseOrderStatut @default(BROUILLON)

  quoteId         Int?            @unique
  clientId        Int
  supplierId      Int

  notes           String?
  total           Decimal?        @db.Decimal(12, 2)
  leadTime        Int?

  paymentInfo     Json?
  shippingInfo    Json?
  alerts          Json?
  trackingNotes   String?

  quote           Quote?          @relation(fields: [quoteId], references: [id])
  client          Client          @relation(fields: [clientId], references: [id])
  supplier        Supplier        @relation(fields: [supplierId], references: [id])
  items           POItem[]

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("purchase_orders")
}

enum PurchaseOrderStatut {
  BROUILLON
  EN_ATTENTE
  CONFIRMEE
  EXPEDIEE
  LIVREE
  ANNULEE
}


// ======================================================
// PO ITEM
// ======================================================

model POItem {
  id                Int             @id @default(autoincrement())

  purchaseOrderId   Int
  productId         Int

  quantity          Int
  price             Decimal         @db.Decimal(12, 2)

  statut            POItemStatut    @default(EN_ATTENTE)
  leadTime          Int?
  fulfillmentStatus FulfillmentStatus @default(EN_ATTENTE)

  notes             String?
  alerts            Json?

  purchaseOrder     PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product           Product         @relation(fields: [productId], references: [id])

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@map("po_items")
}

enum POItemStatut {
  EN_ATTENTE
  CONFIRME
  ANNULE
}

enum FulfillmentStatus {
  EN_ATTENTE
  EN_PREPARATION
  EXPEDIE
  LIVRE
} 

// ======================================================
// OTP
// ======================================================
model OtpCode {
  id Int @id @default(autoincrement())

  email String

  codeHash String

  type OtpType

  expiresAt DateTime

  attempts Int @default(0)

  verified Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([email])
  @@index([email, type])
  @@map("otp_codes")
}

enum OtpType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}