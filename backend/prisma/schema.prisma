generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id    Int    @id @default(autoincrement())
  nom   String
  prenom String
  email String @unique
  password String
  role   Role 
  statut  UserStatut
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

enum Role {
  ADMIN
  VENDEUR
  ACHETEUR
}

enum UserStatut {
  ACTIF
  INACTIF
}